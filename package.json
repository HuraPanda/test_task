{
  "name": "sobes",
  "version": "1.0.0",
  "description": "Minimal anonymous AI gateway with React, Express and PostgreSQL",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server.mjs",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/gateway.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
